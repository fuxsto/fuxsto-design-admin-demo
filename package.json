{
  "name": "fuxsto-design-admin-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A production-shaped admin template built with fuxsto-design: Vue 3.5 + TypeScript + Vite 6 + Tailwind CSS v4, covering 84/84 library exports.",
  "keywords": [
    "vue",
    "vue3",
    "admin",
    "admin-template",
    "dashboard",
    "template",
    "starter",
    "tailwindcss",
    "tailwindcss-v4",
    "typescript",
    "vite",
    "component-library",
    "fuxsto-design",
    "ui"
  ],
  "license": "MIT",
  "author": "fuxsto",
  "homepage": "https://github.com/fuxsto/fuxsto-design-admin-demo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fuxsto/fuxsto-design-admin-demo.git"
  },
  "bugs": {
    "url": "https://github.com/fuxsto/fuxsto-design-admin-demo/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "audit": "node scripts/coverage-audit.cjs && node scripts/prop-legality-audit.cjs && node scripts/fallthrough-audit.cjs",
    "verify": "npm run type-check && npm run audit"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "fuxsto-design": "^0.2.0",
    "lucide-vue-next": "^0.577.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0"
  }
}
